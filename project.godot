; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Wild Jam 98"
run/main_scene="uid://dl6oq10p5g33a"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://c1jyn0mt5fr2g"

[autoload]

SignalBus="*uid://cewnwi2qldog4"
AudioManager="*uid://du68jrnx210o4"
TurnConfig="*uid://bnr5vt2fg75es"
DialogConfig="*uid://u5sc5wb77u6f"
PauseLayer="*uid://b8n2bis048ml3"
ScreenFadeLayer="*uid://c0aqvfojvyvvg"
PlayerStats="*uid://c4cir7rl81xj1"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg")

[file_customization]

folder_colors={
"res://levels/": "green",
"res://scratch_levels/": "red"
}

[global_group]

frog=""
frog_pipe=""
signal_emitter=""
block_tile_map=""
radio_tile_map=""

