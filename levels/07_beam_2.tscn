[node name="Level" type="Node2D" unique_id=706673764 node_paths=PackedStringArray("grid")]
script = ExtResource("1_v6yvr")
grid = NodePath("Grid")
level_name = "A E I O U"
explanation = "Pipes are locked as flip instructions, so the signal beam is the only way to change an instruction.
The pipe spawn order isn't controllable by the player, so they have to disable the left pipe (which spawns frogs before the right pipe) to spawn an initial frog from the right.

For the contrived solution, the first frog going through the beam twice feels unnecessary.

A frog limit of 3 sort of makes this level work."
metadata/_custom_type_script = "uid://c5fglonfx4x5p"

